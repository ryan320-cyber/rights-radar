# PostgreSQL Database Configuration (Neon Serverless or standard PostgreSQL)
SQL_HOST="ep-your-subdomain-pooler.c-6.us-east-2.aws.neon.tech"
SQL_USER="neondb_owner"
SQL_PASSWORD="your-neon-password"
SQL_DB_NAME="neondb"
SQL_PORT="5432"

# Gemini GenAI API Key for Regulatory Pulse & Flight Grounding Search
GEMINI_API_KEY="your-gemini-api-key"

# Optional: Full URL format for Drizzle or external tools
DATABASE_URL="postgresql://neondb_owner:your-neon-password@ep-your-subdomain-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Application hosting
PORT="3000"
APP_URL="http://localhost:3000"
